<Project Sdk="Microsoft.NET.Sdk">

    <!-- The child process of IO.Astrodynamics.Tests' ColdStartTests (#623): a fresh process, in which no static class of
         the library has been initialized yet. The test project builds it and copies its output to ColdStart/ next to its
         own. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\IO.Astrodynamics\IO.Astrodynamics.csproj" />
    </ItemGroup>

</Project>
