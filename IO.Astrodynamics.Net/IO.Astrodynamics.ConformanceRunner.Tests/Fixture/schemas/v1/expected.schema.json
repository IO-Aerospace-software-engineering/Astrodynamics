{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://conformance-tests.local/schemas/v1/expected.schema.json",
 "title": "Conformance Test Expected Output",
 "description": "Validates a golden-answer file.  All output values may be null (triggers SKIP in the runner).",
 "type": "object",
 "$defs": {
  "nullable_number": {
   "anyOf": [
    {
     "type": "number"
    },
    {
     "type": "null"
    }
   ]
  },
  "nullable_string": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ]
  },
  "nullable_boolean": {
   "anyOf": [
    {
     "type": "boolean"
    },
    {
     "type": "null"
    }
   ]
  },
  "statistics": {
   "type": "object",
   "properties": {
    "mean": {
     "type": "number"
    },
    "median": {
     "type": "number"
    },
    "min": {
     "type": "number"
    },
    "max": {
     "type": "number"
    }
   },
   "required": [],
   "additionalProperties": false
  },
  "tracking_arcs": {
   "type": "object",
   "properties": {
    "rise": {
     "type": "string"
    },
    "fall": {
     "type": "string"
    }
   },
   "required": [
    "rise",
    "fall"
   ],
   "additionalProperties": false
  },
  "tracking_statistics": {
   "type": "object",
   "properties": {
    "range (km)": {
     "$ref": "#/$defs/statistics"
    },
    "doppler (km/s)": {
     "$ref": "#/$defs/statistics"
    },
    "azimuth (deg)": {
     "$ref": "#/$defs/statistics"
    },
    "elevation (deg)": {
     "$ref": "#/$defs/statistics"
    }
   },
   "required": [],
   "additionalProperties": false
  },
  "nullable_quaternion": {
   "description": "Unit quaternion in scalar-first order [w, x, y, z], or null; null anywhere means SKIP (spec.md sections 4 and 7).",
   "type": [
    "array",
    "null"
   ],
   "items": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "minItems": 4,
   "maxItems": 4
  },
  "pointing_triad_outputs": {
   "type": "object",
   "properties": {
    "attitude_quaternion": {
     "$ref": "#/$defs/nullable_quaternion"
    },
    "target_in_fov": {
     "$ref": "#/$defs/nullable_boolean"
    }
   },
   "required": [
    "attitude_quaternion",
    "target_in_fov"
   ],
   "additionalProperties": false
  },
  "eclipse_outputs": {
   "type": "object",
   "properties": {
    "penumbra_entry": {
     "$ref": "#/$defs/nullable_string"
    },
    "umbra_entry": {
     "$ref": "#/$defs/nullable_string"
    },
    "umbra_exit": {
     "$ref": "#/$defs/nullable_string"
    },
    "penumbra_exit": {
     "$ref": "#/$defs/nullable_string"
    },
    "penumbra_duration_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "umbra_duration_s": {
     "$ref": "#/$defs/nullable_number"
    }
   },
   "required": [
    "penumbra_entry",
    "umbra_entry",
    "umbra_exit",
    "penumbra_exit",
    "penumbra_duration_s",
    "umbra_duration_s"
   ],
   "additionalProperties": false
  },
  "propagator_outputs": {
   "type": "object",
   "properties": {
    "final_x_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_y_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_z_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_vx_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_vy_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_vz_km_s": {
     "$ref": "#/$defs/nullable_number"
    }
   },
   "required": [
    "final_x_km",
    "final_y_km",
    "final_z_km"
   ],
   "additionalProperties": false
  },
  "tracking_data_outputs": {
   "type": "object",
   "properties": {
    "arcs": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/tracking_arcs"
     }
    },
    "statistics": {
     "$ref": "#/$defs/tracking_statistics"
    }
   },
   "required": [
    "arcs",
    "statistics"
   ],
   "additionalProperties": false
  },
  "geosynchronous_outputs": {
   "type": "object",
   "properties": {
    "semi_major_axis_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "eccentricity": {
     "$ref": "#/$defs/nullable_number"
    },
    "inclination_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "raan_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "argp_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "mean_anomaly_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "position_x_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "position_y_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "position_z_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "velocity_x_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "velocity_y_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "velocity_z_km_s": {
     "$ref": "#/$defs/nullable_number"
    }
   },
   "required": [
    "semi_major_axis_km",
    "eccentricity",
    "inclination_deg",
    "raan_deg",
    "argp_deg",
    "mean_anomaly_deg",
    "position_x_km",
    "position_y_km",
    "position_z_km",
    "velocity_x_km_s",
    "velocity_y_km_s",
    "velocity_z_km_s"
   ],
   "additionalProperties": false
  },
  "nullable_vec3": {
   "description": "Three numbers, or null; null anywhere means SKIP (spec.md section 7).",
   "type": [
    "array",
    "null"
   ],
   "items": {
    "$ref": "#/$defs/nullable_number"
   },
   "minItems": 3,
   "maxItems": 3
  },
  "orbital_elements_outputs": {
   "description": "The outputs a case checks are the keys present (spec.md section 7); spec.md section 11.1 defines each.",
   "type": "object",
   "properties": {
    "semi_major_axis_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "eccentricity": {
     "$ref": "#/$defs/nullable_number"
    },
    "inclination_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "raan_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "argp_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "true_anomaly_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "mean_anomaly_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "eccentric_anomaly_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "hyperbolic_anomaly_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "hyperbolic_mean_anomaly_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "argument_of_latitude_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "longitude_of_periapsis_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "true_longitude_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "mean_longitude_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "periapsis_radius_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "apoapsis_radius_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "semi_latus_rectum_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "period_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "specific_energy_km2_s2": {
     "$ref": "#/$defs/nullable_number"
    },
    "angular_momentum_km2_s": {
     "$ref": "#/$defs/nullable_vec3"
    },
    "periapsis_speed_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "apoapsis_speed_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "mean_motion_rad_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "mod_equinoctial_f": {
     "$ref": "#/$defs/nullable_number"
    },
    "mod_equinoctial_g": {
     "$ref": "#/$defs/nullable_number"
    },
    "mod_equinoctial_h": {
     "$ref": "#/$defs/nullable_number"
    },
    "mod_equinoctial_k": {
     "$ref": "#/$defs/nullable_number"
    },
    "right_ascension_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "declination_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "position_km": {
     "$ref": "#/$defs/nullable_vec3"
    },
    "velocity_km_s": {
     "$ref": "#/$defs/nullable_vec3"
    }
   },
   "minProperties": 1,
   "additionalProperties": false
  },
  "time_conversion_outputs": {
   "type": "object",
   "properties": {
    "tai_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "utc_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "tt_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "tdb_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "gps_s": {
     "$ref": "#/$defs/nullable_number"
    }
   },
   "minProperties": 1,
   "additionalProperties": false
  },
  "frame_transformation_outputs": {
   "type": "object",
   "properties": {
    "position_km": {
     "$ref": "#/$defs/nullable_vec3"
    },
    "velocity_km_s": {
     "$ref": "#/$defs/nullable_vec3"
    },
    "latitude_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "longitude_deg": {
     "$ref": "#/$defs/nullable_number"
    },
    "altitude_km": {
     "$ref": "#/$defs/nullable_number"
    }
   },
   "minProperties": 1,
   "additionalProperties": false
  },
  "stm_outputs": {
   "description": "Phi(t_end, t_start), 6 rows of 6 numbers, in the frame of the case; the same in km and km/s as in m and m/s (the rv block in s, the vr block in 1/s). Compared by 3 x 3 block (stm_block). The final state is optional, compared as for the propagator category.",
   "type": "object",
   "properties": {
    "final_stm": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/nullable_number"
      },
      "minItems": 6,
      "maxItems": 6
     },
     "minItems": 6,
     "maxItems": 6
    },
    "final_x_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_y_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_z_km": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_vx_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_vy_km_s": {
     "$ref": "#/$defs/nullable_number"
    },
    "final_vz_km_s": {
     "$ref": "#/$defs/nullable_number"
    }
   },
   "required": [
    "final_stm"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "id",
  "category",
  "case_version",
  "generated_by",
  "outputs"
 ],
 "properties": {
  "id": {
   "type": "string"
  },
  "category": {
   "type": "string",
   "enum": [
    "pointing_triad",
    "eclipse",
    "propagator",
    "tracking_data",
    "geosynchronous",
    "orbital_elements",
    "time_conversion",
    "frame_transformation",
    "stm"
   ]
  },
  "case_version": {
   "type": "string",
   "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
  },
  "generated_by": {
   "type": "object",
   "properties": {
    "tool": {
     "type": "string"
    },
    "tool_version": {
     "type": "string"
    },
    "kernel": {
     "type": "string"
    },
    "date": {
     "type": "string"
    },
    "gravity_model": {
     "type": "string"
    },
    "perturbations": {
     "type": "string"
    },
    "integrator": {
     "type": "string"
    },
    "method": {
     "type": "string"
    },
    "reference_frame": {
     "type": "string",
     "description": "Frame in which the reference tool produced the golden, e.g. EarthMJ2000Eq (GMAT) or J2000 (SPICE)."
    },
    "tool_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "script": {
     "type": "string",
     "description": "File name of the reference script, next to the case."
    },
    "log": {
     "type": "string",
     "description": "File name of the reference run's console log, next to the case."
    }
   },
   "required": [
    "tool",
    "tool_version",
    "kernel",
    "date"
   ],
   "additionalProperties": false
  },
  "outputs": {
   "type": "object"
  }
 },
 "additionalProperties": false,
 "if": {
  "properties": {
   "category": {
    "const": "pointing_triad"
   }
  }
 },
 "then": {
  "properties": {
   "outputs": {
    "$ref": "#/$defs/pointing_triad_outputs"
   }
  }
 },
 "else": {
  "if": {
   "properties": {
    "category": {
     "const": "eclipse"
    }
   }
  },
  "then": {
   "properties": {
    "outputs": {
     "$ref": "#/$defs/eclipse_outputs"
    }
   }
  },
  "else": {
   "if": {
    "properties": {
     "category": {
      "const": "propagator"
     }
    }
   },
   "then": {
    "properties": {
     "outputs": {
      "$ref": "#/$defs/propagator_outputs"
     }
    }
   },
   "else": {
    "if": {
     "properties": {
      "category": {
       "const": "tracking_data"
      }
     }
    },
    "then": {
     "properties": {
      "outputs": {
       "$ref": "#/$defs/tracking_data_outputs"
      }
     }
    },
    "else": {
     "if": {
      "properties": {
       "category": {
        "const": "geosynchronous"
       }
      }
     },
     "then": {
      "properties": {
       "outputs": {
        "$ref": "#/$defs/geosynchronous_outputs"
       }
      }
     }
    }
   }
  }
 },
 "allOf": [
  {
   "if": {
    "properties": {
     "category": {
      "const": "orbital_elements"
     }
    }
   },
   "then": {
    "properties": {
     "outputs": {
      "$ref": "#/$defs/orbital_elements_outputs"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "category": {
      "const": "time_conversion"
     }
    }
   },
   "then": {
    "properties": {
     "outputs": {
      "$ref": "#/$defs/time_conversion_outputs"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "category": {
      "const": "frame_transformation"
     }
    }
   },
   "then": {
    "properties": {
     "outputs": {
      "$ref": "#/$defs/frame_transformation_outputs"
     }
    }
   }
  },
  {
   "if": {
    "properties": {
     "category": {
      "const": "stm"
     }
    }
   },
   "then": {
    "properties": {
     "outputs": {
      "$ref": "#/$defs/stm_outputs"
     }
    }
   }
  }
 ]
}
