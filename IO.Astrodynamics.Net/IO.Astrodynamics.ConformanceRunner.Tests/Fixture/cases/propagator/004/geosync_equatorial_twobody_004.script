%--------------------------------------------------------------
%  GMAT Script: geosync_equatorial_twobody_004
%
%  Description:
%    Validates the analytical geosynchronous orbit computation
%    for an equatorial case (inclination = 0 degrees).
%
%    A spacecraft is placed in a perfectly circular equatorial
%    orbit whose semi-major axis is derived from Kepler's third
%    law using the sidereal rotation period T_sid = 86164.0998101 s
%    (SPICE IAU_EARTH at J2000) and GM = 398600.4355070226 km^3/s^2
%    (SPICE DE440).
%
%    The orbit is propagated for exactly one sidereal period using
%    two-body dynamics (point-mass Earth, no perturbations).  If
%    the semi-major axis is correct, the satellite returns to its
%    initial state to within numerical precision.
%
%  Analytical values:
%    a   = (GM * T_sid^2 / (4*pi^2))^(1/3)
%        = 42164.172439443049 km
%    v   = sqrt(GM / a)
%        = 3.0746599725961645 km/s
%    T   = 2*pi*sqrt(a^3/GM) = 86164.0998101 s  (matches T_sid)
%
%  Initial state (EarthMJ2000Eq):
%    Satellite on +X axis (RAAN=0, AOP=0, TA=0), circular equatorial.
%    X = a, Y = 0, Z = 0, VX = 0, VY = v, VZ = 0
%
%  Expected result:
%    After one sidereal period, final state = initial state.
%
%  Integrator: PrinceDormand78 (RK7/8), accuracy 1e-13
%--------------------------------------------------------------

%----------------------------------------
%---------- Solar System Configuration
%----------------------------------------

% Override Earth GM to match SPICE DE440 value (default: 398600.4415)
GMAT Earth.Mu = 398600.4355070226;

% No ephemeris source needed (two-body only, no third-body perturbations)

%----------------------------------------
%---------- Spacecraft
%----------------------------------------

Create Spacecraft GEO_EQ;

GEO_EQ.DateFormat       = UTCGregorian;
GEO_EQ.Epoch            = '15 Jun 2026 00:00:00.000';
GEO_EQ.CoordinateSystem = EarthMJ2000Eq;
GEO_EQ.DisplayStateType = Cartesian;

% Circular equatorial orbit at GEO radius
% Satellite placed on +X axis of ICRF (TA=0, RAAN=0, AOP=0)
GEO_EQ.X  =  42164.172439443049;
GEO_EQ.Y  =      0.0;
GEO_EQ.Z  =      0.0;
GEO_EQ.VX =      0.0;
GEO_EQ.VY =      3.0746599725961645;
GEO_EQ.VZ =      0.0;

%----------------------------------------
%---------- Force Model (two-body only)
%----------------------------------------

Create ForceModel FM_TwoBody;

FM_TwoBody.CentralBody  = Earth;
FM_TwoBody.PointMasses  = {Earth};
FM_TwoBody.ErrorControl = RSSStep;

%----------------------------------------
%---------- Propagator
%----------------------------------------

Create Propagator Prop_RK78;

Prop_RK78.FM              = FM_TwoBody;
Prop_RK78.Type            = PrinceDormand78;
Prop_RK78.InitialStepSize = 60;
Prop_RK78.Accuracy        = 1e-13;
Prop_RK78.MinStep         = 0.001;
Prop_RK78.MaxStep         = 60;
Prop_RK78.MaxStepAttempts = 50;

%----------------------------------------
%---------- Subscribers (output)
%----------------------------------------

Create ReportFile StateReport;
StateReport.Filename     = 'geosync_equatorial_twobody_004_output.txt';
StateReport.WriteHeaders = true;
StateReport.ColumnWidth  = 28;
StateReport.Precision    = 16;
StateReport.WriteReport  = true;

Create ReportFile ElementReport;
ElementReport.Filename     = 'geosync_equatorial_twobody_004_elements.txt';
ElementReport.WriteHeaders = true;
ElementReport.ColumnWidth  = 28;
ElementReport.Precision    = 16;
ElementReport.WriteReport  = true;

%----------------------------------------
%---------- Mission Sequence
%----------------------------------------

BeginMissionSequence;

% Report initial Cartesian state
Report StateReport GEO_EQ.UTCGregorian ...
    GEO_EQ.EarthMJ2000Eq.X  GEO_EQ.EarthMJ2000Eq.Y  GEO_EQ.EarthMJ2000Eq.Z ...
    GEO_EQ.EarthMJ2000Eq.VX GEO_EQ.EarthMJ2000Eq.VY GEO_EQ.EarthMJ2000Eq.VZ;

% Report initial Keplerian elements
Report ElementReport GEO_EQ.UTCGregorian ...
    GEO_EQ.Earth.SMA  GEO_EQ.Earth.ECC ...
    GEO_EQ.Earth.INC  GEO_EQ.Earth.RAAN ...
    GEO_EQ.Earth.AOP  GEO_EQ.Earth.TA ...
    GEO_EQ.Earth.OrbitPeriod;

% Propagate for exactly one sidereal rotation period (86164.0998101 seconds)
Propagate Prop_RK78(GEO_EQ) {GEO_EQ.ElapsedSecs = 86164.0998101};

% Report final Cartesian state
Report StateReport GEO_EQ.UTCGregorian ...
    GEO_EQ.EarthMJ2000Eq.X  GEO_EQ.EarthMJ2000Eq.Y  GEO_EQ.EarthMJ2000Eq.Z ...
    GEO_EQ.EarthMJ2000Eq.VX GEO_EQ.EarthMJ2000Eq.VY GEO_EQ.EarthMJ2000Eq.VZ;

% Report final Keplerian elements
Report ElementReport GEO_EQ.UTCGregorian ...
    GEO_EQ.Earth.SMA  GEO_EQ.Earth.ECC ...
    GEO_EQ.Earth.INC  GEO_EQ.Earth.RAAN ...
    GEO_EQ.Earth.AOP  GEO_EQ.Earth.TA ...
    GEO_EQ.Earth.OrbitPeriod;
