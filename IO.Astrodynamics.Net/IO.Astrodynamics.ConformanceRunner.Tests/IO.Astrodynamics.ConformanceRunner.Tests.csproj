<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="6.0.4">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\IO.Astrodynamics.ConformanceRunner\IO.Astrodynamics.ConformanceRunner.csproj" />
    </ItemGroup>

    <!-- The fixtures, written by tools/conformance/sync_fixture.py from the conformance-tests suite, each with the
         schemas and tolerances of the suite and the data files that differ from the runner's and from the earlier
         fixtures: Fixture/Lot1, the cases of orbital_elements, time_conversion and frame_transformation 001 to 031;
         Fixture/Lot2, the propagator cases 006 to 018; Fixture/Lot3, the maneuver and lambert cases; Fixture/Lot4, the
         ground_station, eclipse, orbital_events and attitude cases; Fixture/Lot5, the sgp4 and tle_conversion cases and
         the TEME frame cases 032 to 036; Fixture/Lot6, the conjunction, collision_probability, cdm and stm cases, the
         CDMs of the cdm cases and the SPKs of conjunction 007 -->
    <!-- The SPK of LRO of the library's tests, which the station case 006 of lot 4 reads (SuiteFixture.Lot4) -->
    <ItemGroup>
        <None Include="..\IO.Astrodynamics.Tests\Data\LRO\lro-reconstructed-2023349_2024075_v01_little_endian.bsp">
            <Link>Data\LRO\lro-reconstructed-2023349_2024075_v01_little_endian.bsp</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="Fixture\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
