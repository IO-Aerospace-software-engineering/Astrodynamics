<Project Sdk="Microsoft.NET.Sdk">

    <!-- The child process of IO.Astrodynamics.Tests' KernelWriterCultureTests (#821, #798): the kernel writers in a named
         culture. The repository runs every project with invariant globalization (Directory.Build.props), under which no
         named culture exists; this one runs outside it, so that CultureInfo.CurrentCulture is the culture the test gives.
         The test project builds it and copies its output to Culture/ next to its own. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
        <InvariantGlobalization>false</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\IO.Astrodynamics\IO.Astrodynamics.csproj" />
        <Compile Include="..\IO.Astrodynamics.Tests\CultureKernelSet.cs" Link="CultureKernelSet.cs" />
        <Compile Include="..\IO.Astrodynamics.Tests\Body\CspiceDirect.cs" Link="CspiceDirect.cs" />
    </ItemGroup>

</Project>
